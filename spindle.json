{
  "version": "0.2.0",
  "name": "Prism",
  "identifier": "lumi_dialogue_colors",
  "author": "kittyafterdark",
  "description": "Bind dialogue colors to Cortex characters and the active persona, recolor existing chats, and inject color rules automatically.",
  "github": "https://github.com/kittyafterdark/Prism",
  "homepage": "https://github.com/kittyafterdark/Prism",
  "permissions": [
    "chats",
    "characters",
    "personas",
    "memories",
    "chat_mutation",
    "interceptor"
  ],
  "entry_backend": "dist/backend.js",
  "entry_frontend": "dist/frontend.js",
  "interceptor_timeout_ms": 3000
}
